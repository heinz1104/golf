<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="my_first_module.PaymentScreenButtons" t-inherit="point_of_sale.PaymentScreenButtons" t-inherit-mode="extension" owl="1">
        <xpath expr="//button[contains(@class, 'next')]" position="attributes">
            <attribute name="t-att-disabled">currentOrder.config.module_pos_restaurant and currentOrder.preparation_status !== 'ready'</attribute>
            <attribute name="t-att-class">{'disabled-btn-style': currentOrder.config.module_pos_restaurant and currentOrder.preparation_status !== 'ready'}</attribute>
        </xpath>
    </t>
</templates>